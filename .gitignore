# 运行环境
.venv/
node_modules/
__pycache__/
*.pyc

# 本地数据：按内容哈希的 OCR 缓存（含绝对路径与中间进度，不该进仓库）
cache/
staging/
sample/
_probe/

# 电子书本体：体积太大（几百 MB/本），且不一定有再分发授权。
# 需要的话自己放进 books/，或去掉这行再提交。
*.pdf
books/

# 打包产物（exe/归档走 GitHub Release，不进 git 历史）
build/
dist/

# 编辑器
.idea/
.vscode/

# 误落到项目目录里的密钥材料（私钥绝不该进仓库）
ssh-ed25519*
*.pem
id_rsa*
id_ed25519*

# 本机 agent 用的推送辅助脚本（不随项目发布）
push.cmd
tools/git_push.py
